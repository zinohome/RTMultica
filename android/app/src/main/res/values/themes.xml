<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App 基础主题（无标题栏，与 Multica 深色背景一致） -->
    <style name="AppTheme" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
    </style>

    <!-- TWA LauncherActivity 启动过渡主题：深色背景防止透明穿透桌面 -->
    <style name="Theme.BrowserHelper.Transparent" parent="android:Theme.NoTitleBar">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <!-- 显式开启硬件加速，修复部分 MIUI 平板渲染黑屏 -->
        <item name="android:hardwareAccelerated">true</item>
        <!-- 禁用窗口内容叠层动画，避免平板多窗口模式下出现黑屏闪烁 -->
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
