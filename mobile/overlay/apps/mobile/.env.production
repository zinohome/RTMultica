# RTMultica overlay — points the RN mobile app at the self-hosted server
# instead of upstream's api.multica.ai. Applied over upstream apps/mobile/.env.production
# by mobile/build-android.sh and the build-android-native.yml CI workflow.
#
# ws is derived inside the app from EXPO_PUBLIC_API_URL (https->wss + /ws),
# yielding wss://multica.m349.net/ws — no separate var needed.
EXPO_PUBLIC_API_URL=https://multica.m349.net
EXPO_PUBLIC_WEB_URL=https://multica.m349.net
